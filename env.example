# Emboss — environment variables reference
# Copy to .env.local (Next.js) and fill in real values. Never commit the filled file.
# Do not invent env var names not listed here — if a new one is genuinely needed,
# add it here first with a comment explaining what it's for.

# --- Gemini / AI ---
# API key for Gemini access
GEMINI_API_KEY=
# Pinned stable multimodal model used by all Gemini call types
GEMINI_MODEL=gemini-3.6-flash

# --- Supabase ---
# Project URL and keys from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side only, never exposed to the client/browser.
# Required for writing job/region rows from route handlers.
SUPABASE_SERVICE_ROLE_KEY=

# --- App config ---
# English UEB braille: 1 = uncontracted, 2 = contracted. Defaults to 2 if unset.
BRAILLE_GRADE=2

# Max pages accepted per PDF upload (see docs/testing-scope.md — v1 test scope is 2-3)
MAX_PDF_PAGES=3

# Max upload file size, in MB. 7 MB chosen as a deliberate safety margin above the
# realistic size of a 2-3 page text/diagram PDF (see AGENTS.md §5 / §12).
MAX_UPLOAD_SIZE_MB=7

# Max upload requests allowed per IP (basic abuse guard for the no-auth setup —
# see AGENTS.md §5 / §12). Not a full rate-limiting system, just a floor.
RATE_LIMIT_UPLOADS_PER_IP=5

# Max retry attempts for a Gemini call whose response fails Zod validation, before
# the region/job is marked failed (see AGENTS.md §4 / §12).
MAX_GEMINI_VALIDATION_RETRIES=3

# Maximum complete FDM tactile plate footprint, including margins, in mm.
# Emboss v1 manufacturing profile, not a BANA paper-size mandate; defaults 180x180.
MAX_PLATE_WIDTH_MM=180
MAX_PLATE_HEIGHT_MM=180

# Emboss manufacturing setting, not a BANA requirement (millimetres).
TACTILE_PLATE_THICKNESS_MM=2.0

# --- Job access ---
# Length/entropy of generated job IDs is a code-level concern, not an env var —
# no config needed here unless a specific requirement emerges.
